# Copy this file to `.env.local` for local development with `vercel dev`.
# In production, set these under Vercel Dashboard → Project → Settings →
# Environment Variables instead of committing a real .env file.

# ---- Firebase Web config ----
# NOTE: These are NOT secrets — Firebase's web config is designed to be
# public and ships inside every Firebase web app's JS bundle. Actual data
# protection comes from Firestore Security Rules (see firestore.rules),
# not from hiding these values.
#
# The static website currently reads its Firebase config from
# `assets/js/firebase-init.js`; these values document the web config rather
# than supplying it at runtime.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Vercel server-side secrets (never expose these to the browser) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_SERVICE_ACCOUNT=
REQUIRE_APP_CHECK=true
