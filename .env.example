# Copy this file to `.env.local` for local development with `vercel dev`.
# In production, set these under Vercel Dashboard → Project → Settings →
# Environment Variables instead of committing a real .env file.

# ---- Firebase Web config ----
# NOTE: These are NOT secrets — Firebase's web config is designed to be
# public and ships inside every Firebase web app's JS bundle. Actual data
# protection comes from Firestore Security Rules (see firestore.rules),
# not from hiding these values.
#
# They are listed here for reference/documentation only. This project
# does not currently read them from environment variables at build time
# (there is no bundler) — instead, paste them directly into
# assets/js/firebase-init.js. If you later add a build step, you can wire
# these env vars into that file instead.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
