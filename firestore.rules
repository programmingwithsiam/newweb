rules_version = '2';

// =============================================================
// FIRESTORE SECURITY RULES — CodeWithSiam
// =============================================================
// Paste this into Firebase Console → Firestore Database → Rules,
// or deploy with the Firebase CLI: `firebase deploy --only firestore:rules`
//
// Model:
//  - courses/{courseId}                          -> public read, admin write
//  - courses/{courseId}/modules/{moduleId}        -> public read, admin write
//  - .../modules/{moduleId}/lessons/{lessonId}    -> public read, admin write
//  - users/{uid}                                  -> private; owner/admin only
//  - publicProfiles/{uid}                         -> allowlisted public profile
//  - publicDirectory/{uid}                        -> minimal public chat directory
//  - progress/{uid}/courses/{courseId}            -> owner-only read/write
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isCommunityUser() {
      return isSignedIn() &&
        (request.auth.token.get('email_verified', false) == true ||
          request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com');
    }

    function isOwner(uid) {
      return isCommunityUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email == 'mdsiamahmmedloselovestroy@gmail.com';
    }

    function validPrivateUserData(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt',
          'username', 'bio', 'location', 'website', 'learningRole', 'skills',
          'profilePicture', 'coverPhoto', 'coverURL', 'online', 'lastSeen',
          'privacyOnline', 'banned'
        ]) &&
        request.resource.data.uid == uid &&
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string && request.resource.data.name.size() <= 120)) &&
        (!('email' in request.resource.data) ||
          request.resource.data.email == request.auth.token.email) &&
        (!('photoURL' in request.resource.data) ||
          request.resource.data.photoURL == null ||
          (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000)) &&
        (!('role' in request.resource.data) ||
          request.resource.data.role == 'student' ||
          (request.resource.data.role == 'admin' && isAdmin())) &&
        (!('bio' in request.resource.data) ||
          (request.resource.data.bio is string && request.resource.data.bio.size() <= 500)) &&
        (!('profilePicture' in request.resource.data) ||
          (request.resource.data.profilePicture is string && request.resource.data.profilePicture.size() <= 2000)) &&
        (!('coverPhoto' in request.resource.data) ||
          (request.resource.data.coverPhoto is string && request.resource.data.coverPhoto.size() <= 2000)) &&
        (!('coverURL' in request.resource.data) ||
          (request.resource.data.coverURL is string && request.resource.data.coverURL.size() <= 2000)) &&
        (!('location' in request.resource.data) || request.resource.data.location is string) &&
        (!('website' in request.resource.data) || request.resource.data.website is string) &&
        (!('learningRole' in request.resource.data) || request.resource.data.learningRole is string) &&
        (!('username' in request.resource.data) ||
          (request.resource.data.username is string && request.resource.data.username.size() <= 30)) &&
        (!('skills' in request.resource.data) || request.resource.data.skills is list) &&
        (!('online' in request.resource.data) || request.resource.data.online is bool) &&
        (!('privacyOnline' in request.resource.data) || request.resource.data.privacyOnline is bool) &&
        (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen is timestamp) &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp) &&
        (!('banned' in request.resource.data) || request.resource.data.banned is bool);
    }

    function validPrivateUserUpdate(uid) {
      return isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'name', 'photoURL', 'username', 'bio', 'location', 'website',
          'learningRole', 'skills', 'profilePicture', 'coverPhoto', 'coverURL',
          'online', 'lastSeen', 'privacyOnline', 'updatedAt'
        ]) &&
        validPrivateUserData(uid) &&
        request.resource.data.get('email', null) == resource.data.get('email', null) &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        request.resource.data.get('banned', false) == resource.data.get('banned', false);
    }

    function hasEnrollment(courseId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId));
    }

    function enrollmentStatus(courseId) {
      return hasEnrollment(courseId)
        ? get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status
        : '';
    }

    function hasLegacyCourseAccess(courseId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.access == 'granted' &&
        (!('courseIds' in get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data) ||
          courseId in get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.courseIds);
    }

    function canAccessCourse(courseId) {
      return isAdmin() ||
        (isVerifiedUser() && enrollmentStatus(courseId) != 'revoked' &&
          (enrollmentStatus(courseId) == 'approved' || hasLegacyCourseAccess(courseId)));
    }

    // ---------------- Courses (public catalog) ----------------
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          // Preview documents are the only lesson documents readable without enrollment.
          // Keep preview reads as document gets so a query over locked lessons
          // cannot expose or infer the rest of the course content.
          allow get: if isAdmin() ||
            (('isFreePreview' in resource.data) && resource.data.isFreePreview == true) ||
            (('freePreview' in resource.data) && resource.data.freePreview == true) ||
            (('order' in resource.data) && resource.data.order <= 1 &&
              get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)).data.order == 0) ||
            canAccessCourse(courseId);
          allow list: if isAdmin() || canAccessCourse(courseId);
          allow write: if isAdmin();
        }
      }
    }

    // ---------------- Course enrollments ----------------
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() ||
        (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        ((request.resource.data.keys().hasOnly(['userId', 'courseId', 'status', 'paymentMethod', 'transactionId', 'paymentId', 'requestedAt', 'accessSource']) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.accessSource == 'payment' &&
          request.resource.data.requestedAt == request.time) ||
         (request.resource.data.keys().hasOnly(['userId', 'courseId', 'status', 'paymentMethod', 'transactionId', 'requestedAt', 'approvedAt', 'approvedBy', 'accessSource']) &&
          request.resource.data.status == 'approved' &&
          request.resource.data.accessSource == 'free' &&
          request.resource.data.paymentMethod == 'free' &&
          request.resource.data.courseId is string &&
          get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price <= 0 &&
          request.resource.data.requestedAt == request.time));
      allow update, delete: if isAdmin();
    }

    // ---------------- Private and public user profiles ----------------
    match /users/{uid} {
      allow get, list: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) &&
        validPrivateUserData(uid) &&
        request.resource.data.get('banned', false) == false &&
        request.auth.uid == uid &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || validPrivateUserUpdate(uid);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      function hasValidPublicProfile() {
        return request.resource.data.keys().hasOnly([
            'uid', 'name', 'displayName', 'photoURL', 'profilePicture', 'coverPhoto', 'coverURL',
            'username', 'searchName', 'bio', 'location', 'website', 'learningRole', 'skills',
            'followers', 'following', 'followersCount', 'followingCount', 'totalProjects',
            'createdAt', 'online', 'lastSeen', 'lastActive', 'updatedAt'
          ]) &&
          request.resource.data.uid == uid &&
          (!('name' in request.resource.data) ||
            (request.resource.data.name is string && request.resource.data.name.size() <= 120)) &&
          (!('displayName' in request.resource.data) ||
            (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120)) &&
          (!('photoURL' in request.resource.data) ||
            (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000)) &&
          (!('profilePicture' in request.resource.data) ||
            (request.resource.data.profilePicture is string && request.resource.data.profilePicture.size() <= 2000)) &&
          (!('coverPhoto' in request.resource.data) || request.resource.data.coverPhoto is string) &&
          (!('coverURL' in request.resource.data) || request.resource.data.coverURL is string) &&
          (!('username' in request.resource.data) ||
            (request.resource.data.username is string && request.resource.data.username.size() <= 30)) &&
          (!('searchName' in request.resource.data) ||
            (request.resource.data.searchName is string && request.resource.data.searchName.size() <= 120)) &&
          (!('bio' in request.resource.data) ||
            (request.resource.data.bio is string && request.resource.data.bio.size() <= 500)) &&
          (!('location' in request.resource.data) ||
            (request.resource.data.location is string && request.resource.data.location.size() <= 120)) &&
          (!('website' in request.resource.data) ||
            (request.resource.data.website is string && request.resource.data.website.size() <= 2048)) &&
          (!('learningRole' in request.resource.data) ||
            (request.resource.data.learningRole is string && request.resource.data.learningRole.size() <= 120)) &&
          (!('skills' in request.resource.data) ||
            (request.resource.data.skills is list && request.resource.data.skills.size() <= 30)) &&
          (!('followers' in request.resource.data) || request.resource.data.followers is list) &&
          (!('following' in request.resource.data) || request.resource.data.following is list) &&
          (!('followersCount' in request.resource.data) ||
            (request.resource.data.followersCount is int && request.resource.data.followersCount >= 0)) &&
          (!('followingCount' in request.resource.data) ||
            (request.resource.data.followingCount is int && request.resource.data.followingCount >= 0)) &&
          (!('totalProjects' in request.resource.data) ||
            (request.resource.data.totalProjects is int && request.resource.data.totalProjects >= 0)) &&
          (!('online' in request.resource.data) || request.resource.data.online is bool);
      }

      function validOwnerProfileUpdate() {
        return isOwner(uid) &&
          hasValidPublicProfile() &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'displayName', 'photoURL', 'profilePicture', 'coverPhoto', 'coverURL',
            'username', 'searchName', 'bio', 'location', 'website', 'learningRole', 'skills',
            'online', 'lastSeen', 'lastActive', 'updatedAt'
          ]);
      }

      allow get: if true;
      allow list: if request.query.limit <= 20;
      allow create: if isOwner(uid) &&
        hasValidPublicProfile() &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.get('followers', []) == [] &&
        request.resource.data.get('following', []) == [] &&
        request.resource.data.get('followersCount', 0) == 0 &&
        request.resource.data.get('followingCount', 0) == 0;
      allow update: if validOwnerProfileUpdate();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /publicDirectory/{uid} {
      function hasValidDirectoryProfile() {
        return request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'photoURL', 'username', 'searchName',
            'online', 'lastSeen', 'lastActive', 'updatedAt'
          ]) &&
          request.resource.data.uid == uid &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 120 &&
          request.resource.data.photoURL is string &&
          request.resource.data.photoURL.size() <= 2000 &&
          request.resource.data.username is string &&
          request.resource.data.username.size() <= 30 &&
          request.resource.data.searchName is string &&
          request.resource.data.searchName.size() <= 120 &&
          request.resource.data.online is bool;
      }

      allow get, list: if isCommunityUser();
      allow create, update: if isOwner(uid) && hasValidDirectoryProfile();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() &&
          resource.data.members is list &&
          request.auth.uid in resource.data.members;
      }

      function otherMember() {
        return resource.data.members[0] == request.auth.uid
          ? resource.data.members[1]
          : resource.data.members[0];
      }

      function ratePath(uid) {
        return /databases/$(database)/documents/chatRateLimits/$(uid);
      }

      function hasValidSendRate() {
        return existsAfter(ratePath(request.auth.uid)) &&
          getAfter(ratePath(request.auth.uid)).data.lastSentAt == request.time &&
          getAfter(ratePath(request.auth.uid)).data.chatId == chatId &&
          (!exists(ratePath(request.auth.uid)) ||
            get(ratePath(request.auth.uid)).data.lastSentAt <= request.time - duration.value(1, 's'));
      }

      function validMessageMetadataUpdate() {
        let messagePath = /databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId);
        let message = getAfter(messagePath).data;
        return existsAfter(messagePath) &&
          message.senderId == request.auth.uid &&
          message.createdAt == request.time &&
          ((message.get('type', 'text') == 'image' &&
            request.resource.data.lastMessage ==
              (message.caption == '' ? '📷 Photo' : '📷 ' + message.caption)) ||
           (message.get('type', 'text') == 'text' &&
            message.text == request.resource.data.lastMessage));
      }

      function validReadUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'readAt']) &&
          request.resource.data.unread is map &&
          request.resource.data.readAt is map &&
          request.resource.data.unread.get(request.auth.uid, 0) == 0 &&
          request.resource.data.readAt.get(request.auth.uid, null) == request.time &&
          request.resource.data.unread.get(otherMember(), 0) == resource.data.unread.get(otherMember(), 0) &&
          request.resource.data.readAt.get(otherMember(), null) ==
            resource.data.get('readAt', {}).get(otherMember(), null);
      }

      function validSendUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt', 'lastMessageId', 'unread']) &&
          request.resource.data.lastMessage is string &&
          request.resource.data.lastMessage.size() <= 2050 &&
          request.resource.data.lastMessageAt == request.time &&
          request.resource.data.lastMessageId is string &&
          request.resource.data.unread is map &&
          request.resource.data.unread.get(request.auth.uid, 0) == 0 &&
          request.resource.data.unread.get(otherMember(), 0) ==
            resource.data.unread.get(otherMember(), 0) + 1 &&
          request.resource.data.get('readAt', {}).get(request.auth.uid, null) ==
            resource.data.get('readAt', {}).get(request.auth.uid, null) &&
          request.resource.data.get('readAt', {}).get(otherMember(), null) ==
            resource.data.get('readAt', {}).get(otherMember(), null) &&
          hasValidSendRate() &&
          validMessageMetadataUpdate();
      }

      allow get: if false && isSignedIn() &&
        (resource == null ||
          (resource.data.members is list && request.auth.uid in resource.data.members));
      allow list: if false && isMember();
      allow create: if false && isSignedIn() &&
        request.resource.data.keys().hasOnly(['id', 'members', 'unread', 'lastMessage', 'lastMessageAt', 'createdAt']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.resource.data.members[0] != request.resource.data.members[1] &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.unread is map &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage == '' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.lastMessageAt == request.time;
      allow update: if false && isMember() &&
        request.resource.data.members == resource.data.members &&
        (validReadUpdate() || validSendUpdate());
      allow delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if false && isSignedIn() &&
          parentChat().members is list &&
          request.auth.uid in parentChat().members;
        allow create: if false && isSignedIn() &&
          parentChat().members is list &&
          request.auth.uid in parentChat().members &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.status == 'sent' &&
          ((request.resource.data.get('type', '') == 'text' &&
            request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'createdAt', 'status', 'replyTo']) &&
            request.resource.data.keys().hasAll(['senderId', 'type', 'text', 'createdAt', 'status']) &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 2000) ||
           (request.resource.data.get('type', '') == 'image' &&
            request.resource.data.keys().hasOnly(['senderId', 'type', 'imageUrl', 'width', 'height', 'caption', 'createdAt', 'status', 'replyTo']) &&
            request.resource.data.keys().hasAll(['senderId', 'type', 'imageUrl', 'width', 'height', 'caption', 'createdAt', 'status']) &&
            request.resource.data.imageUrl is string &&
            request.resource.data.imageUrl.matches('^https://res\\.cloudinary\\.com/fyelzeqn/.*$') &&
            request.resource.data.width is int &&
            request.resource.data.width > 0 &&
            request.resource.data.height is int &&
            request.resource.data.height > 0 &&
            request.resource.data.caption is string &&
            request.resource.data.caption.size() <= 2000)) &&
          hasValidSendRate();
        allow update: if false && isSignedIn() &&
          parentChat().members is list &&
          request.auth.uid in parentChat().members &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deletedForEveryone', 'deletedFor', 'text', 'imageData', 'imageUrl', 'caption', 'status']) &&
          (!('status' in request.resource.data) ||
            request.resource.data.status in ['sent', 'deleted']) &&
          (!('deletedForEveryone' in request.resource.data) ||
            request.resource.data.deletedForEveryone is bool) &&
          (!('deletedFor' in request.resource.data) ||
            (request.resource.data.deletedFor is list &&
              request.auth.uid in request.resource.data.deletedFor)) &&
          (!('text' in request.resource.data) ||
            (request.resource.data.text is string && request.resource.data.text.size() <= 2000)) &&
          (!('imageData' in request.resource.data) ||
            (request.resource.data.imageData is string && request.resource.data.imageData == '')) &&
          (!('caption' in request.resource.data) ||
            (request.resource.data.caption is string && request.resource.data.caption.size() <= 2000)) &&
          (!('imageUrl' in request.resource.data) ||
            request.resource.data.imageUrl == '' ||
            (request.resource.data.imageUrl is string &&
              request.resource.data.imageUrl.matches('^https://res\\.cloudinary\\.com/fyelzeqn/.*$')));
        allow delete: if false && isSignedIn() &&
          parentChat().members is list &&
          request.auth.uid in parentChat().members &&
          resource.data.senderId == request.auth.uid;
      }

      match /typing/{uid} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if false && isSignedIn() &&
          parentChat().members is list &&
          request.auth.uid in parentChat().members;
        allow create, update: if false && isSignedIn() &&
          parentChat().members is list &&
          request.auth.uid in parentChat().members &&
          request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['isTyping', 'updatedAt']) &&
          request.resource.data.isTyping is bool &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false && isSignedIn() &&
          parentChat().members is list &&
          request.auth.uid in parentChat().members &&
          request.auth.uid == uid;
      }
    }

    match /chatRateLimits/{uid} {
      function hasChatMembership(chatId) {
        let chatPath = /databases/$(database)/documents/chats/$(chatId);
        return exists(chatPath) &&
          request.auth.uid in get(chatPath).data.members;
      }

      function sendIntervalElapsed() {
        return !exists(/databases/$(database)/documents/chatRateLimits/$(uid)) ||
          get(/databases/$(database)/documents/chatRateLimits/$(uid)).data.lastSentAt
            <= request.time - duration.value(1, 's');
      }

      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['chatId', 'lastSentAt']) &&
        request.resource.data.chatId is string &&
        request.resource.data.lastSentAt == request.time &&
        hasChatMembership(request.resource.data.chatId) &&
        sendIntervalElapsed();
      allow delete: if false;
    }

    match /authorized_users/{email} {
      allow read: if isAdmin() ||
        (isVerifiedUser() && email == request.auth.token.email);
      allow write: if isAdmin();
    }

    // ---------------- Payment submissions ----------------
    match /payments/{paymentId} {
      allow create: if isVerifiedUser() &&
        request.resource.data.keys().hasOnly(['userId', 'studentName', 'studentEmail', 'courseId', 'courseTitle', 'amount', 'paidAmount', 'paidCurrency', 'method', 'transactionId', 'phone', 'paymentDate', 'screenshotUrl', 'status', 'submittedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.studentEmail is string &&
        request.resource.data.studentEmail.size() <= 254 &&
        request.resource.data.studentEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.courseId is string && request.resource.data.courseId.size() > 0 &&
        request.resource.data.method in ['bkash', 'rocket', 'nagad', 'bank', 'visa', 'debit_card', 'credit_card', 'paypal', 'upi', 'free'] &&
        ((!request.resource.data.keys().hasAny(['paidAmount', 'paidCurrency']) && request.resource.data.method != 'free') ||
          (request.resource.data.keys().hasAll(['paidAmount', 'paidCurrency']) &&
            request.resource.data.paidAmount is number &&
            ((request.resource.data.method == 'free' &&
              request.resource.data.paidAmount == 0 && request.resource.data.paidCurrency == 'BDT') ||
             (request.resource.data.method != 'free' &&
              request.resource.data.paidAmount > 0 && request.resource.data.paidCurrency in ['BDT', 'USD', 'INR'])))) &&
        request.resource.data.transactionId is string &&
        ((request.resource.data.method == 'free' && request.resource.data.transactionId == '') ||
          (request.resource.data.method != 'free' && request.resource.data.transactionId.size() > 0)) &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$') &&
        (request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price ||
          (get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.discountPrice > 0 &&
            request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.discountPrice)) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.submittedAt == request.time;
      allow read: if isAdmin() ||
        (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (isVerifiedUser() && resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenshotUrl']) &&
          request.resource.data.screenshotUrl is string && request.resource.data.screenshotUrl.size() <= 2000);
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() ||
        (settingId == 'liveStream' && resource.data.enabled == true);
      allow write: if isAdmin();
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isCommunityUser() &&
        request.resource.data.keys().hasOnly(['text', 'imageData', 'authorUid', 'authorName', 'avatarUrl', 'authorIsAdmin', 'reactions', 'createdAt']) &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.imageData is string && request.resource.data.imageData.size() <= 700000 &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.authorIsAdmin is bool &&
        request.resource.data.reactions is map &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() ||
        (isCommunityUser() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions is map &&
          (!('reactions' in resource.data) ||
            request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid] is map) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].userId == request.auth.uid) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].postId == postId) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].reactionType in ['like', 'love', 'haha', 'wow', 'celebrate', 'fire', 'helpful']));
      allow delete: if isAdmin() || (isCommunityUser() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isCommunityUser() && request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['text', 'authorName', 'avatarUrl', 'authorUid', 'parentId', 'parentName', 'createdAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 &&
          request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
          request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
          request.resource.data.authorUid is string && request.resource.data.authorUid.size() > 0 &&
          request.resource.data.parentId is string && request.resource.data.parentName is string &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin() || (isCommunityUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    // Public messages for the website-owned live chat. Keep the payload small
    // and predictable; moderation can remove documents from the console.
    match /liveChatMessages/{messageId} {
      allow read: if true;
      allow create: if isCommunityUser() &&
        !exists(/databases/$(database)/documents/muted_users/$(request.auth.uid)) &&
        request.resource.data.keys().hasOnly(['liveSessionId', 'name', 'avatarUrl', 'text', 'parentId', 'parentName', 'authorUid', 'authorIsAdmin', 'likes', 'pinned', 'createdAt']) &&
        request.resource.data.liveSessionId is string && request.resource.data.liveSessionId.size() > 0 &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 32 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 240 &&
        request.resource.data.parentId is string && request.resource.data.parentName is string &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorIsAdmin == isAdmin() &&
        request.resource.data.likes is list && request.resource.data.likes.size() <= 1000 &&
        request.resource.data.pinned == false && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() ||
        (isCommunityUser() && resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.authorIsAdmin == resource.data.authorIsAdmin &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likes', 'updatedAt', 'editedAt']));
      allow delete: if isAdmin() || (isCommunityUser() && resource.data.authorUid == request.auth.uid);
    }

    match /muted_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['online', 'lastSeen', 'typing']) &&
        request.resource.data.online is bool && request.resource.data.lastSeen == request.time;
    }

    match /stories/{storyId} {
      allow read: if false;
      allow create: if false && isVerifiedUser() &&
        request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'avatarUrl', 'type', 'content', 'mediaUrl', 'imageData', 'category', 'createdAt', 'expiresAt', 'viewers', 'music']) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.type is string && request.resource.data.type in ['text', 'image'] &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000 &&
        request.resource.data.mediaUrl is string &&
        request.resource.data.category is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.viewers is list &&
        (!('music' in request.resource.data) || (request.resource.data.music is map && request.resource.data.music.videoId is string && request.resource.data.music.videoId.size() > 0 && request.resource.data.music.videoId.size() <= 20));
      allow update: if false && isVerifiedUser() &&
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']) &&
          request.resource.data.viewers is list) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions is map &&
          ((!('reactions' in resource.data) &&
            request.resource.data.reactions.keys().hasOnly([request.auth.uid])) ||
           (('reactions' in resource.data) &&
            request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))) &&
          (!request.resource.data.reactions.keys().hasAny([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid] in ['like', 'love', 'care', 'haha', 'wow', 'sad', 'angry'])) ||
         (resource.data.authorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'content', 'mediaUrl', 'imageData', 'category', 'music']) &&
          request.resource.data.type in ['text', 'image'] &&
          request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000 &&
          request.resource.data.mediaUrl is string && request.resource.data.category is string &&
          request.resource.data.expiresAt == resource.data.expiresAt));
      allow delete: if false && isVerifiedUser() && resource.data.authorUid == request.auth.uid;
    }

    // ---------------- Community app (Firestore) ----------------
    // The following collections power /community. Admin membership is
    // provisioned only from the Firebase console/Admin SDK.
    function communitySignedIn() {
      return request.auth != null;
    }

    function communityActive() {
      return isCommunityUser() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false);
    }

    function communityNotBlocked(otherUid) {
      return !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + otherUid)) &&
        !exists(/databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid));
    }

    function communityAdmin() {
      return communitySignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validCommunityMedia(data) {
      return !data.keys().hasAny(['mediaAssetId', 'mediaURL', 'mediaPublicId', 'mediaType']) ||
        (data.keys().hasAll(['mediaAssetId', 'mediaURL', 'mediaPublicId', 'mediaType']) &&
          data.mediaAssetId is string &&
          exists(/databases/$(database)/documents/mediaAssets/$(data.mediaAssetId)) &&
          get(/databases/$(database)/documents/mediaAssets/$(data.mediaAssetId)).data.ownerUid == request.auth.uid &&
          data.mediaURL == get(/databases/$(database)/documents/mediaAssets/$(data.mediaAssetId)).data.secureUrl &&
          data.mediaPublicId == get(/databases/$(database)/documents/mediaAssets/$(data.mediaAssetId)).data.publicId);
    }

    function validExternalMedia(data) {
      return !('externalMediaURL' in data) ||
        (data.externalMediaURL is string &&
          data.externalMediaURL.size() <= 2048 &&
          data.externalMediaURL.matches(
            '^https://(www\\.|m\\.)?(youtube\\.com|youtu\\.be|facebook\\.com|fb\\.watch|fb\\.com|instagram\\.com)(/.*)?$'
          ) &&
          !data.keys().hasAny(['mediaAssetId', 'mediaURL', 'mediaPublicId', 'mediaType']));
    }

    function validPostRate() {
      let ratePath = /databases/$(database)/documents/writeRates/$(request.auth.uid);
      return existsAfter(ratePath) &&
        getAfter(ratePath).data.lastPostAt == request.time &&
        (!exists(ratePath) ||
          !('lastPostAt' in get(ratePath).data) ||
          get(ratePath).data.lastPostAt <=
            request.time - duration.value(10, 's'));
    }

    function validMessageRate() {
      let ratePath = /databases/$(database)/documents/writeRates/$(request.auth.uid);
      return existsAfter(ratePath) &&
        getAfter(ratePath).data.lastMessageAt == request.time &&
        (!exists(ratePath) ||
          !('lastMessageAt' in get(ratePath).data) ||
          get(ratePath).data.lastMessageAt <=
            request.time - duration.value(1, 's'));
    }

    match /users/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin() || (isOwner(uid) && request.query.limit <= 10);
      allow create: if isOwner(uid) &&
        validPrivateUserData(uid) &&
        request.resource.data.get('banned', false) == false &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() ||
        validPrivateUserUpdate(uid) ||
        (communityAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'role']) &&
          request.resource.data.get('uid', uid) == uid &&
          (!('banned' in request.resource.data) || request.resource.data.banned is bool) &&
          (!('role' in request.resource.data) || request.resource.data.role in ['student', 'admin']));
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if communitySignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /posts/{postId} {
      allow get: if true;
      allow list: if request.query.limit <= 20;
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorPhoto', 'text', 'mediaAssetId',
          'mediaURL', 'mediaPublicId', 'mediaType', 'postType', 'likeCount',
          'commentCount', 'createdAt', 'updatedAt', 'externalMediaURL',
          'feel', 'background'
        ]) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() <= 120 &&
        request.resource.data.authorPhoto is string && request.resource.data.authorPhoto.size() <= 2000 &&
        request.resource.data.text is string && request.resource.data.text.size() <= 5000 &&
        request.resource.data.postType == 'post' &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        (!('feel' in request.resource.data) ||
          (request.resource.data.feel is string && request.resource.data.feel.size() <= 80)) &&
        (!('background' in request.resource.data) ||
          (request.resource.data.background is string && request.resource.data.background.size() <= 100)) &&
        request.resource.data.createdAt == request.time &&
        validCommunityMedia(request.resource.data) &&
        validExternalMedia(request.resource.data) &&
        validPostRate();
      allow update: if communityActive() &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 5000 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if communityAdmin();

      match /comments/{commentId} {
        allow get: if true;
        allow list: if request.query.limit <= 30;
        // Comment creation and deletion go through authenticated APIs to keep
        // the denormalized counter and ownership checks atomic.
        allow create, update: if false;
        allow delete: if communityAdmin();

        match /reactions/{uid} {
          allow get: if true;
          allow list: if request.query.limit <= 30;
          allow create, update, delete: if false;
        }
      }

      match /reactions/{uid} {
        allow get: if true;
        allow list: if request.query.limit <= 30;
        allow create, update, delete: if false;
      }
    }

    match /writeRates/{uid} {
      allow read: if communitySignedIn() && request.auth.uid == uid;
      allow create: if communityActive() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['lastPostAt', 'lastMessageAt']) &&
        ((request.resource.data.keys().hasOnly(['lastPostAt']) && request.resource.data.lastPostAt == request.time) ||
         (request.resource.data.keys().hasOnly(['lastMessageAt']) && request.resource.data.lastMessageAt == request.time));
      allow update: if communityActive() &&
        request.auth.uid == uid &&
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPostAt']) &&
          request.resource.data.lastPostAt == request.time &&
          (!('lastPostAt' in resource.data) ||
            resource.data.lastPostAt <= request.time - duration.value(10, 's'))) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt']) &&
          request.resource.data.lastMessageAt == request.time &&
          (!('lastMessageAt' in resource.data) ||
            resource.data.lastMessageAt <= request.time - duration.value(1, 's'))));
      allow delete: if false;
    }

    match /follows/{followId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    match /stories/{storyId} {
      allow get: if resource.data.expiresAt > request.time;
      allow list: if request.query.limit <= 20 && resource.data.expiresAt > request.time;
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorPhoto', 'text', 'mediaAssetId',
          'mediaURL', 'mediaPublicId', 'mediaType', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(24, 'h') &&
        validCommunityMedia(request.resource.data);
      allow update: if false;
      allow delete: if communityAdmin() || (communityActive() && resource.data.authorUid == request.auth.uid);
    }

    match /reels/{reelId} {
      allow get: if true;
      allow list: if request.query.limit <= 20;
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorPhoto', 'text', 'mediaAssetId',
          'mediaURL', 'mediaPublicId', 'mediaType', 'duration', 'createdAt'
        ]) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.mediaType == 'video' &&
        request.resource.data.duration is number &&
        request.resource.data.duration > 0 && request.resource.data.duration <= 60 &&
        request.resource.data.createdAt == request.time &&
        validCommunityMedia(request.resource.data) &&
        get(/databases/$(database)/documents/mediaAssets/$(request.resource.data.mediaAssetId)).data.kind == 'reel';
      allow update: if false;
      allow delete: if communityAdmin() || (communityActive() && resource.data.authorUid == request.auth.uid);
    }

    match /chats/{chatId} {
      function chatMember() {
        return communitySignedIn() &&
          resource.data.members is list &&
          request.auth.uid in resource.data.members;
      }

      function otherChatMember() {
        return resource.data.members[0] == request.auth.uid
          ? resource.data.members[1]
          : resource.data.members[0];
      }

      function validChatSend() {
        let messagePath = /databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId);
        let message = getAfter(messagePath).data;
        return !resource.data.get('archived', false) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageAt', 'updatedAt', 'lastMessageId',
            'lastMessageUid', 'unread'
          ]) &&
          existsAfter(messagePath) &&
          message.senderUid == request.auth.uid &&
          message.text == request.resource.data.lastMessage &&
          message.createdAt == request.time &&
          request.resource.data.lastMessageUid == request.auth.uid &&
          request.resource.data.lastMessageAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.unread is map &&
          request.resource.data.unread.get(request.auth.uid, -1) == 0 &&
          request.resource.data.unread.get(otherChatMember(), -1) ==
            resource.data.unread.get(otherChatMember(), 0) + 1 &&
          communityNotBlocked(otherChatMember()) &&
          validMessageRate();
      }

      function validChatRead() {
        return !resource.data.get('archived', false) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'readAt']) &&
          request.resource.data.unread is map &&
          request.resource.data.readAt is map &&
          request.resource.data.unread.get(request.auth.uid, -1) == 0 &&
          request.resource.data.unread.get(otherChatMember(), -1) ==
            resource.data.unread.get(otherChatMember(), 0) &&
          request.resource.data.readAt.get(request.auth.uid, null) == request.time &&
          request.resource.data.readAt.get(otherChatMember(), null) ==
            resource.data.get('readAt', {}).get(otherChatMember(), null);
      }

      allow get: if communitySignedIn() && (resource == null || chatMember());
      allow list: if chatMember() && request.query.limit <= 30;
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly(['members', 'lastMessage', 'updatedAt', 'createdAt', 'unread', 'readAt']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members[0] != request.resource.data.members[1] &&
        request.resource.data.lastMessage == '' &&
        request.resource.data.unread is map &&
        request.resource.data.unread.get(request.resource.data.members[0], -1) == 0 &&
        request.resource.data.unread.get(request.resource.data.members[1], -1) == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if chatMember() && communityActive() && !resource.data.get('archived', false) &&
        request.resource.data.members == resource.data.members &&
        ((validChatSend() && request.resource.data.lastMessage is string &&
           request.resource.data.lastMessage.size() <= 4000) || validChatRead());
      allow delete: if false;

      match /messages/{messageId} {
        function parentMember() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          return communitySignedIn() && chat.members is list && request.auth.uid in chat.members;
        }

        function peerUid() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          return chat.members[0] == request.auth.uid ? chat.members[1] : chat.members[0];
        }

        allow get: if parentMember();
        allow list: if parentMember() && request.query.limit <= 30;
        allow create: if communityActive() &&
          parentMember() &&
          !get(/databases/$(database)/documents/chats/$(chatId)).data.get('archived', false) &&
          communityNotBlocked(peerUid()) &&
          request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt']) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.createdAt == request.time &&
          validMessageRate() &&
          getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessage == request.resource.data.text &&
          getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId == messageId;
        allow update, delete: if false;
      }

      match /typing/{uid} {
        function parentMember() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          return communitySignedIn() && chat.members is list && request.auth.uid in chat.members;
        }
        allow read: if parentMember();
        allow create, update: if communityActive() &&
          parentMember() &&
          !get(/databases/$(database)/documents/chats/$(chatId)).data.get('archived', false) &&
          request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['isTyping', 'updatedAt']) &&
          request.resource.data.isTyping is bool &&
          request.resource.data.updatedAt == request.time;
        allow delete: if communityActive() && parentMember() &&
          !get(/databases/$(database)/documents/chats/$(chatId)).data.get('archived', false) &&
          request.auth.uid == uid;
      }
    }

    match /notifications/{uid}/items/{itemId} {
      allow get, delete: if communitySignedIn() && request.auth.uid == uid;
      allow list: if communitySignedIn() && request.auth.uid == uid && request.query.limit <= 20;
      allow update: if communitySignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
      allow create: if false;
    }

    match /reports/{reportId} {
      allow get: if communityAdmin() ||
        (communitySignedIn() && resource.data.reporterUid == request.auth.uid);
      allow list: if communityAdmin() && request.query.limit <= 50;
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'reason', 'createdAt', 'status']) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.targetType in ['post', 'comment', 'user'] &&
        request.resource.data.targetId is string &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 1000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'open';
      allow update, delete: if communityAdmin();
    }

    match /blocks/{blockId} {
      allow get: if communitySignedIn() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow list: if communitySignedIn() && request.query.limit <= 50 &&
        (resource.data.ownerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'blockedUid', 'createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.blockedUid is string &&
        request.resource.data.blockedUid != request.auth.uid &&
        blockId == request.auth.uid + '_' + request.resource.data.blockedUid &&
        request.resource.data.createdAt == request.time;
      allow delete: if communityActive() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /mutes/{muteId} {
      allow read: if communitySignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'mutedUid', 'createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.mutedUid is string &&
        request.resource.data.mutedUid != request.auth.uid &&
        muteId == request.auth.uid + '_' + request.resource.data.mutedUid &&
        request.resource.data.createdAt == request.time;
      allow delete: if communityActive() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /savedPosts/{savedPostId} {
      allow get: if communitySignedIn() && resource.data.ownerUid == request.auth.uid;
      allow list: if communitySignedIn() &&
        request.query.limit <= 20 &&
        resource.data.ownerUid == request.auth.uid;
      allow create: if communityActive() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'postId', 'createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.postId.size() <= 150 &&
        savedPostId == request.auth.uid + '_' + request.resource.data.postId &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow delete: if communityActive() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /mediaAssets/{assetId} {
      allow get: if communitySignedIn() &&
        resource.data.ownerUid == request.auth.uid;
      allow list, write: if false;
    }

    match /uploadRates/{uid} {
      allow get: if communitySignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read, delete: if false && isOwner(uid);
      allow create: if false && isVerifiedUser() && request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.type is string && request.resource.data.type.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
        request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 &&
        request.resource.data.createdAt == request.time;
      allow update: if false && isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt == request.time;
    }

    // ---------------- Learning progress (private to each user) ----------------
    match /progress/{uid}/courses/{courseId} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
