rules_version = '2';

// =============================================================
// FIRESTORE SECURITY RULES — CodeWithSiam
// =============================================================
// Paste this into Firebase Console → Firestore Database → Rules,
// or deploy with the Firebase CLI: `firebase deploy --only firestore:rules`
//
// Model:
//  - courses/{courseId}                          -> public read, admin write
//  - courses/{courseId}/modules/{moduleId}        -> public read, admin write
//  - .../modules/{moduleId}/lessons/{lessonId}    -> public read, admin write
//  - users/{uid}                                  -> owner read/write,
//                                                     only the configured admin
//                                                     email receives admin access
//  - progress/{uid}/courses/{courseId}            -> owner-only read/write
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'mdsiamahmmedloselovestroy@gmail.com';
    }

    function canAccessCourse(courseId) {
      return isAdmin() || (isGoogleUser() &&
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.access == 'granted');
    }

    // ---------------- Courses (public catalog) ----------------
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          // Video lesson documents contain protected video URLs.
          // Require users to be signed in to read lesson documents.
          allow read: if canAccessCourse(courseId);
          allow write: if isAdmin();
        }
      }
    }

    // ---------------- User profiles ----------------
    match /users/{uid} {
      allow read: if true; // Profiles are public so they show in community

      // A user may create their own profile document on first sign-in.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'role', 'createdAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.createdAt == request.time &&
        ((request.auth.token.email == 'mdsiamahmmedloselovestroy@gmail.com' && request.resource.data.role == 'admin') ||
          (!('role' in request.resource.data) || request.resource.data.role == 'student'));

      // A user may update their own profile fields, including new profile fields
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'photoURL', 'username', 'bio', 'learningRole', 'skills', 'profilePicture', 'coverPhoto', 'location', 'website', 'followers', 'following', 'totalProjects', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /authorized_users/{email} {
      allow read: if isAdmin() ||
        (isGoogleUser() && email == request.auth.token.email);
      allow write: if isAdmin();
    }

    // ---------------- Payment submissions ----------------
    match /payments/{paymentId} {
      allow create: if isGoogleUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.transactionId is string &&
        request.resource.data.transactionId.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$') &&
        (request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price ||
          (get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.discountPrice > 0 &&
            request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.discountPrice)) &&
        request.resource.data.status == 'pending';
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() ||
        (settingId == 'liveStream' && resource.data.enabled == true);
      allow write: if isAdmin();
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isGoogleUser() &&
        request.resource.data.keys().hasOnly(['text', 'imageData', 'authorUid', 'authorName', 'avatarUrl', 'authorIsAdmin', 'reactions', 'createdAt']) &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.imageData is string && request.resource.data.imageData.size() <= 700000 &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.authorIsAdmin is bool &&
        request.resource.data.reactions is map &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() ||
        (isGoogleUser() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions is map &&
          (!('reactions' in resource.data) ||
            request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid] is map) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].userId == request.auth.uid) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].postId == postId) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].reactionType in ['like', 'love', 'haha', 'wow', 'celebrate', 'fire', 'helpful']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['text', 'authorName', 'avatarUrl', 'authorUid', 'parentId', 'parentName', 'createdAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 &&
          request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
          request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
          request.resource.data.authorUid is string && request.resource.data.authorUid.size() > 0 &&
          request.resource.data.parentId is string && request.resource.data.parentName is string &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // Public messages for the website-owned live chat. Keep the payload small
    // and predictable; moderation can remove documents from the console.
    match /liveChatMessages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/muted_users/$(request.auth.uid)) &&
        request.resource.data.keys().hasOnly(['liveSessionId', 'name', 'avatarUrl', 'text', 'parentId', 'parentName', 'authorUid', 'authorIsAdmin', 'likes', 'pinned', 'createdAt']) &&
        request.resource.data.liveSessionId is string && request.resource.data.liveSessionId.size() > 0 &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 32 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 240 &&
        request.resource.data.parentId is string && request.resource.data.parentName is string &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorIsAdmin == isAdmin() &&
        request.resource.data.likes is list && request.resource.data.likes.size() <= 1000 &&
        request.resource.data.pinned == false && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.authorIsAdmin == resource.data.authorIsAdmin &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likes', 'updatedAt', 'editedAt']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /muted_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /directMessages/{conversationId}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participants;
      allow create: if isSignedIn() && request.resource.data.keys().hasOnly(['senderId', 'receiverId', 'text', 'parentId', 'parentText', 'reactions', 'createdAt']) && request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId is string && request.resource.data.receiverId != request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participants &&
        request.resource.data.receiverId in get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participants &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
        request.resource.data.parentId is string && request.resource.data.parentText is string && request.resource.data.reactions is map &&
        request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && ((resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])) || (request.auth.uid in get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participants && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) || (resource.data.receiverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt == request.time));
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    match /directConversations/{conversationId} {
      allow list, read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants is list && request.resource.data.participants.size() == 2 &&
        request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() > 0 && request.resource.data.lastMessage.size() <= 1000 &&
        request.resource.data.participantNames is map && request.resource.data.participantAvatars is map &&
        (!('nicknames' in request.resource.data) || request.resource.data.nicknames is map) &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants is list && request.resource.data.participants.size() == 2 &&
        request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() > 0 && request.resource.data.lastMessage.size() <= 1000 &&
        request.resource.data.participantNames is map && request.resource.data.participantAvatars is map &&
        (!('nicknames' in request.resource.data) || request.resource.data.nicknames is map) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantNames', 'participantAvatars', 'nicknames', 'lastMessage', 'updatedAt']);
    }

    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['online', 'lastSeen', 'typing']) &&
        request.resource.data.online is bool && request.resource.data.lastSeen == request.time;
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isGoogleUser() &&
        request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'avatarUrl', 'type', 'content', 'mediaUrl', 'imageData', 'category', 'createdAt', 'expiresAt', 'viewers', 'music']) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.type is string && request.resource.data.type in ['text', 'image'] &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000 &&
        request.resource.data.mediaUrl is string &&
        request.resource.data.category is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.viewers is list &&
        (!('music' in request.resource.data) || (request.resource.data.music is map && request.resource.data.music.videoId is string && request.resource.data.music.videoId.size() > 0 && request.resource.data.music.videoId.size() <= 20));
      allow update: if isSignedIn() &&
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']) &&
          request.resource.data.viewers is list) ||
         (resource.data.authorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'content', 'mediaUrl', 'imageData', 'category', 'music']) &&
          request.resource.data.type in ['text', 'image'] &&
          request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000 &&
          request.resource.data.mediaUrl is string && request.resource.data.category is string &&
          request.resource.data.expiresAt == resource.data.expiresAt));
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read, delete: if isOwner(uid);
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.type is string && request.resource.data.type.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
        request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 &&
        request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt == request.time;
    }

    // ---------------- Learning progress (private to each user) ----------------
    match /progress/{uid}/courses/{courseId} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
