rules_version = '2';

// =============================================================
// FIRESTORE SECURITY RULES — CodeWithSiam
// =============================================================
// Paste this into Firebase Console → Firestore Database → Rules,
// or deploy with the Firebase CLI: `firebase deploy --only firestore:rules`
//
// Model:
//  - courses/{courseId}                          -> public read, admin write
//  - courses/{courseId}/modules/{moduleId}        -> public read, admin write
//  - .../modules/{moduleId}/lessons/{lessonId}    -> public read, admin write
//  - users/{uid}                                  -> owner + admin read,
//                                                     owner can create/update
//                                                     their own profile but
//                                                     NEVER their own role
//  - progress/{uid}/courses/{courseId}            -> owner-only read/write
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------------- Courses (public catalog) ----------------
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // ---------------- User profiles ----------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // A user may create their own profile document (e.g. on first
      // sign-in) but can never set their own role to admin.
      allow create: if isOwner(uid) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student');

      // A user may update their own profile fields, but the "role"
      // field can never be changed by the user themselves — only an
      // admin (editing through the Firebase console or a trusted
      // server context) can promote/demote roles.
      allow update: if isAdmin() ||
        (isOwner(uid) && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ---------------- Learning progress (private to each user) ----------------
    match /progress/{uid}/courses/{courseId} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
