rules_version = '2';

// =============================================================
// FIRESTORE SECURITY RULES — CodeWithSiam
// =============================================================
// Paste this into Firebase Console → Firestore Database → Rules,
// or deploy with the Firebase CLI: `firebase deploy --only firestore:rules`
//
// Model:
//  - courses/{courseId}                          -> public read, admin write
//  - courses/{courseId}/modules/{moduleId}        -> public read, admin write
//  - .../modules/{moduleId}/lessons/{lessonId}    -> public read, admin write
//  - users/{uid}                                  -> owner read/write,
//                                                     only the configured admin
//                                                     email receives admin access
//  - progress/{uid}/courses/{courseId}            -> owner-only read/write
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email == 'mdsiamahmmedloselovestroy@gmail.com';
    }

    function hasEnrollment(courseId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId));
    }

    function enrollmentStatus(courseId) {
      return hasEnrollment(courseId)
        ? get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status
        : '';
    }

    function hasLegacyCourseAccess(courseId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.access == 'granted' &&
        (!('courseIds' in get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data) ||
          courseId in get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.courseIds);
    }

    function canAccessCourse(courseId) {
      return isAdmin() ||
        (isVerifiedUser() && enrollmentStatus(courseId) != 'revoked' &&
          (enrollmentStatus(courseId) == 'approved' || hasLegacyCourseAccess(courseId)));
    }

    // ---------------- Courses (public catalog) ----------------
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          // Preview documents are the only lesson documents readable without enrollment.
          // Keep preview reads as document gets so a query over locked lessons
          // cannot expose or infer the rest of the course content.
          allow get: if isAdmin() ||
            (('isFreePreview' in resource.data) && resource.data.isFreePreview == true) ||
            (('freePreview' in resource.data) && resource.data.freePreview == true) ||
            (('order' in resource.data) && resource.data.order <= 1 &&
              get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)).data.order == 0) ||
            canAccessCourse(courseId);
          allow list: if isAdmin() || canAccessCourse(courseId);
          allow write: if isAdmin();
        }
      }
    }

    // ---------------- Course enrollments ----------------
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() ||
        (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        ((request.resource.data.keys().hasOnly(['userId', 'courseId', 'status', 'paymentMethod', 'transactionId', 'paymentId', 'requestedAt', 'accessSource']) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.accessSource == 'payment' &&
          request.resource.data.requestedAt == request.time) ||
         (request.resource.data.keys().hasOnly(['userId', 'courseId', 'status', 'paymentMethod', 'transactionId', 'requestedAt', 'approvedAt', 'approvedBy', 'accessSource']) &&
          request.resource.data.status == 'approved' &&
          request.resource.data.accessSource == 'free' &&
          request.resource.data.paymentMethod == 'free' &&
          request.resource.data.courseId is string &&
          get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price <= 0 &&
          request.resource.data.requestedAt == request.time));
      allow update, delete: if isAdmin();
    }

    // ---------------- User profiles ----------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && resource.data.members is list && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() &&
        request.resource.data.members is list &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.size() == 2 &&
        request.resource.data.createdAt is timestamp;
      allow update: if isSignedIn() &&
        resource.data.members is list &&
        request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members;
      allow delete: if isSignedIn() && resource.data.members is list && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.members is list &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.members is list &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.createdAt is timestamp;
        allow update, delete: if isSignedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.members is list &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          resource.data.senderId == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.members is list &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow write: if isSignedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.members is list &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          request.auth.uid == uid;
      }
    }

    match /authorized_users/{email} {
      allow read: if isAdmin() ||
        (isVerifiedUser() && email == request.auth.token.email);
      allow write: if isAdmin();
    }

    // ---------------- Payment submissions ----------------
    match /payments/{paymentId} {
      allow create: if isVerifiedUser() &&
        request.resource.data.keys().hasOnly(['userId', 'studentName', 'studentEmail', 'courseId', 'courseTitle', 'amount', 'method', 'transactionId', 'phone', 'paymentDate', 'screenshotUrl', 'status', 'submittedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.courseId is string && request.resource.data.courseId.size() > 0 &&
        request.resource.data.method in ['bkash', 'rocket', 'nagad', 'bank', 'visa', 'debit_card', 'credit_card', 'paypal'] &&
        request.resource.data.transactionId is string &&
        request.resource.data.transactionId.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$') &&
        (request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price ||
          (get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.discountPrice > 0 &&
            request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.discountPrice)) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.submittedAt == request.time;
      allow read: if isAdmin() ||
        (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (isVerifiedUser() && resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenshotUrl']) &&
          request.resource.data.screenshotUrl is string && request.resource.data.screenshotUrl.size() <= 2000);
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() ||
        (settingId == 'liveStream' && resource.data.enabled == true);
      allow write: if isAdmin();
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isVerifiedUser() &&
        request.resource.data.keys().hasOnly(['text', 'imageData', 'authorUid', 'authorName', 'avatarUrl', 'authorIsAdmin', 'reactions', 'createdAt']) &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.imageData is string && request.resource.data.imageData.size() <= 700000 &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.authorIsAdmin is bool &&
        request.resource.data.reactions is map &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() ||
        (isVerifiedUser() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions is map &&
          (!('reactions' in resource.data) ||
            request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid] is map) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].userId == request.auth.uid) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].postId == postId) &&
          (!request.resource.data.reactions.keys().hasAll([request.auth.uid]) ||
            request.resource.data.reactions[request.auth.uid].reactionType in ['like', 'love', 'haha', 'wow', 'celebrate', 'fire', 'helpful']));
      allow delete: if isAdmin() || (isVerifiedUser() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isVerifiedUser() && request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['text', 'authorName', 'avatarUrl', 'authorUid', 'parentId', 'parentName', 'createdAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 &&
          request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
          request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
          request.resource.data.authorUid is string && request.resource.data.authorUid.size() > 0 &&
          request.resource.data.parentId is string && request.resource.data.parentName is string &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin() || (isVerifiedUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    // Public messages for the website-owned live chat. Keep the payload small
    // and predictable; moderation can remove documents from the console.
    match /liveChatMessages/{messageId} {
      allow read: if true;
      allow create: if isVerifiedUser() &&
        !exists(/databases/$(database)/documents/muted_users/$(request.auth.uid)) &&
        request.resource.data.keys().hasOnly(['liveSessionId', 'name', 'avatarUrl', 'text', 'parentId', 'parentName', 'authorUid', 'authorIsAdmin', 'likes', 'pinned', 'createdAt']) &&
        request.resource.data.liveSessionId is string && request.resource.data.liveSessionId.size() > 0 &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 32 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 240 &&
        request.resource.data.parentId is string && request.resource.data.parentName is string &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorIsAdmin == isAdmin() &&
        request.resource.data.likes is list && request.resource.data.likes.size() <= 1000 &&
        request.resource.data.pinned == false && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() ||
        (isVerifiedUser() && resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.authorIsAdmin == resource.data.authorIsAdmin &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likes', 'updatedAt', 'editedAt']));
      allow delete: if isAdmin() || (isVerifiedUser() && resource.data.authorUid == request.auth.uid);
    }

    match /muted_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isVerifiedUser() && request.auth.uid in resource.data.members;

      allow create: if isVerifiedUser() &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members[0] != request.resource.data.members[1] &&
        request.resource.data.unread is map &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 1000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.lastMessageAt == request.time &&
        request.resource.data.unread[request.resource.data.members[0]] is int &&
        request.resource.data.unread[request.resource.data.members[1]] is int;

      allow update: if isVerifiedUser() &&
        request.auth.uid in resource.data.members &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'unread']) &&
        request.resource.data.unread is map &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 1000;

      allow delete: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isVerifiedUser() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;

      allow create: if isVerifiedUser() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['senderId', 'text', 'imageData', 'createdAt', 'status', 'replyTo', 'deletedForEveryone', 'deletedFor']) &&
        request.resource.data.senderId is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status in ['sent', 'deleted'] &&
        (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 3000)) &&
        (!('imageData' in request.resource.data) || (request.resource.data.imageData is string && request.resource.data.imageData.size() <= 1000000)) &&
        (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map && request.resource.data.replyTo.id is string));

      allow update: if isVerifiedUser() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'imageData', 'status', 'deletedForEveryone', 'deletedFor']) &&
        (resource.data.senderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);

      allow delete: if isAdmin() || (isVerifiedUser() && resource.data.senderId == request.auth.uid);
    }

    match /chats/{chatId}/typing/{uid} {
      allow read: if isVerifiedUser() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;

      allow create, update: if isVerifiedUser() &&
        request.auth.uid == uid &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
        request.resource.data.keys().hasOnly(['isTyping', 'updatedAt']) &&
        request.resource.data.isTyping is bool &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isVerifiedUser() && request.auth.uid == uid;
    }

    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['online', 'lastSeen', 'typing']) &&
        request.resource.data.online is bool && request.resource.data.lastSeen == request.time;
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isVerifiedUser() &&
        request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'avatarUrl', 'type', 'content', 'mediaUrl', 'imageData', 'category', 'createdAt', 'expiresAt', 'viewers', 'music']) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80 &&
        request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 1000 &&
        request.resource.data.type is string && request.resource.data.type in ['text', 'image'] &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000 &&
        request.resource.data.mediaUrl is string &&
        request.resource.data.category is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.viewers is list &&
        (!('music' in request.resource.data) || (request.resource.data.music is map && request.resource.data.music.videoId is string && request.resource.data.music.videoId.size() > 0 && request.resource.data.music.videoId.size() <= 20));
      allow update: if isVerifiedUser() &&
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']) &&
          request.resource.data.viewers is list) ||
         (resource.data.authorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'content', 'mediaUrl', 'imageData', 'category', 'music']) &&
          request.resource.data.type in ['text', 'image'] &&
          request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000 &&
          request.resource.data.mediaUrl is string && request.resource.data.category is string &&
          request.resource.data.expiresAt == resource.data.expiresAt));
      allow delete: if isVerifiedUser() && resource.data.authorUid == request.auth.uid;
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read, delete: if isOwner(uid);
      allow create: if isVerifiedUser() && request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.type is string && request.resource.data.type.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
        request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 &&
        request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt == request.time;
    }

    // ---------------- Learning progress (private to each user) ----------------
    match /progress/{uid}/courses/{courseId} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
