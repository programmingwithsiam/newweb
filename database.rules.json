{
  "rules": {
    ".read": false,
    ".write": false,
    "authRegistrationPending": {
      ".read": false,
      ".write": false
    },
    "users": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".indexOn": [
        "usernameLower",
        "nameLower"
      ],
      "$uid": {
        ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".validate": "newData.hasChildren(['fullName','username','usernameLower'])",
        "followersCount": {
          ".write": "auth != null && auth.token.email_verified === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 || newData.val() === 1 : (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))"
        },
        "followingCount": {
          ".write": "auth != null && auth.token.email_verified === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 || newData.val() === 1 : (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))"
        },
        "friendsCount": {
          ".write": "auth != null && auth.token.email_verified === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 || newData.val() === 1 : (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))"
        },
        "notifPrefs": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
        }
      }
    },
    "privateUsers": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 320"
        }
      }
    },
    "usernames": {
      ".read": "auth != null && auth.token.email_verified === true",
      "$usernameKey": {
        ".write": "auth != null && auth.token.email_verified === true && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "posts": {
      "$postId": {
        ".read": "data.child('privacy').val() === 'public' || (auth != null && auth.token.email_verified === true && (data.child('uid').val() === auth.uid || root.child('friends').child(auth.uid).child(data.child('uid').val()).exists()))",
        ".write": "auth != null && auth.token.email_verified === true && (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid','privacy','createdAt'])",
        "reactionsCount": {
          ".write": "auth != null && auth.token.email_verified === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 || newData.val() === 1 : (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))"
        },
        "commentCount": {
          ".write": "auth != null && auth.token.email_verified === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() === 0 || newData.val() === 1 : (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))"
        }
      }
    },
    "publicPostsIndex": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "uid"
      ],
      "$postId": {
        ".write": "auth != null && auth.token.email_verified === true && ((newData.exists() && newData.child('uid').val() === auth.uid && root.child('posts').child($postId).child('privacy').val() === 'public') || (!newData.exists() && data.child('uid').val() === auth.uid))"
      }
    },
    "userPosts": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || root.child('friends').child(auth.uid).child($uid).exists())",
        ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
      }
    },
    "reactions": {
      "$postId": {
        ".read": "auth != null && auth.token.email_verified === true",
        "$uid": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
        }
      }
    },
    "comments": {
      "$postId": {
        ".read": "root.child('posts').child($postId).child('privacy').val() === 'public'",
        "$commentId": {
          ".write": "auth != null && auth.token.email_verified === true && (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid)"
        }
      }
    },
    "commentReactions": {
      "$commentId": {
        ".read": "auth != null && auth.token.email_verified === true",
        "$uid": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
        }
      }
    },
    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $toUid",
        "$fromUid": {
          ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $toUid || auth.uid === $fromUid)",
          ".write": "auth != null && auth.token.email_verified === true && (auth.uid === $fromUid || auth.uid === $toUid)",
          ".validate": "!newData.exists() || (newData.child('status').exists() && $fromUid !== $toUid)"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || root.child('users').child($uid).child('isPrivate').val() != true || root.child('friends').child(auth.uid).child($uid).exists())",
        "$friendUid": {
          ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || auth.uid === $friendUid)",
          ".write": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || auth.uid === $friendUid) && (!newData.exists() || root.child('friendRequests').child(auth.uid).child(auth.uid === $uid ? $friendUid : $uid).exists())"
        }
      }
    },
    "followers": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        "$followerUid": {
          ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || auth.uid === $followerUid)",
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $followerUid"
        }
      }
    },
    "following": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        "$followingUid": {
          ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || auth.uid === $followingUid)",
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
        }
      }
    },
    "blockedUsers": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        "$blockedUid": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
        }
      }
    },
    "conversations": {
      "$convId": {
        ".read": "auth != null && auth.token.email_verified === true && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && auth.token.email_verified === true && !data.exists() && newData.child('members').child(auth.uid).exists()",
        "members": {
          "$memberUid": {
            ".write": "auth != null && auth.token.email_verified === true && (auth.uid === $memberUid || root.child('groupMembers').child($convId).child(auth.uid).child('role').val() === 'admin' || !root.child('groupMembers').child($convId).exists())"
          }
        },
        "lastMessage": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 2010"
        },
        "lastMessageAt": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "lastMessageOrder": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "lastMessageId": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "lastMessageSenderUid": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.val() === auth.uid || (newData.val() === '' && newData.parent().child('lastMessage').val() === '')"
        },
        "lastMessageSenderName": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "lastMessageSenderPhotoURL": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "unreadByUid": {
          ".write": "auth != null && auth.token.email_verified === true && data.parent().child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && data.parent().parent().child('members').child(auth.uid).exists()"
          }
        },
        "readAt": {
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && data.parent().parent().child('members').child(auth.uid).exists()"
          }
        }
      }
    },
    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".indexOn": [
          "lastMessageAt",
          "lastMessageOrder"
        ],
        "$convId": {
          "members": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()"
          },
          "lastMessage": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 2010"
          },
          "lastMessageAt": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.isNumber()"
          },
          "lastMessageOrder": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.isNumber()"
          },
          "lastMessageId": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "lastMessageSenderUid": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.val() === auth.uid || (newData.val() === '' && newData.parent().child('lastMessage').val() === '')"
          },
          "lastMessageSenderName": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "lastMessageSenderPhotoURL": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },
          "unreadCount": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "unreadByUid": {
            ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()"
          },
          "readAt": {
            "$readerUid": {
              ".write": "auth != null && auth.token.email_verified === true && auth.uid === $readerUid && root.child('conversations').child($convId).child('members').child(auth.uid).exists()"
            }
          }
        }
      }
    },
    "messages": {
      "$convId": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
        ".indexOn": [
          "createdAt",
          "createdAtOrder"
        ],
        "$msgId": {
          ".write": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists() && (!data.exists() ? newData.child('senderId').val() === auth.uid && newData.child('createdAt').val() === now && newData.child('createdAtOrder').val() === now && (root.child('conversations').child($convId).child('lastMessageSenderUid').val() !== auth.uid || root.child('conversations').child($convId).child('lastMessageAt').val() <= now - 1000) : data.child('senderId').val() === auth.uid)",
          ".validate": "newData.child('senderId').val() === auth.uid && newData.child('createdAt').val() === (data.exists() ? data.child('createdAt').val() : now) && newData.child('createdAtOrder').val() === (data.exists() ? data.child('createdAtOrder').val() : now) && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 2000)) && (!newData.child('caption').exists() || (newData.child('caption').isString() && newData.child('caption').val().length <= 2000)) && (newData.child('type').val() !== 'image' || newData.child('deletedForEveryone').val() === true || (newData.child('imageUrl').isString() && newData.child('imageUrl').val().beginsWith('https://res.cloudinary.com/fyelzeqn/') && newData.child('width').isNumber() && newData.child('height').isNumber()) || (data.exists() && !data.child('imageUrl').exists() && newData.child('imageUrl').val() === data.child('imageUrl').val()))",
          "seenBy": {
            "$uid": {
              ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && root.child('conversations').child($convId).child('members').child(auth.uid).exists()"
            }
          }
        }
      }
    },
    "messageReactions": {
      "$convId": {
        "$msgId": {
          ".read": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && root.child('conversations').child($convId).child('members').child(auth.uid).exists()"
          }
        }
      }
    },
    "groupMembers": {
      "$convId": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.token.email_verified === true && ((auth.uid === $uid && !newData.exists()) || (!root.child('groupMembers').child($convId).exists() && auth.uid === $uid) || root.child('groupMembers').child($convId).child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "typing": {
      "$convId": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('conversations').child($convId).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && root.child('conversations').child($convId).child('members').child(auth.uid).exists()"
        }
      }
    },
    "presence": {
      ".read": "auth != null && auth.token.email_verified === true",
      "$uid": {
        ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".indexOn": [
          "createdAt",
          "read"
        ],
        "$notifId": {
          ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.child('fromUid').val() === auth.uid) || auth.uid === $uid)"
        }
      }
    },
    "messageNotifications": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".indexOn": [
          "createdAt",
          "read"
        ],
        "$notifId": {
          ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.child('fromUid').val() === auth.uid) || auth.uid === $uid)"
        }
      }
    },
    "reports": {
      "$reportId": {
        ".read": "auth != null && auth.token.email_verified === true && data.child('reporterId').val() === auth.uid",
        ".write": "auth != null && auth.token.email_verified === true && !data.exists() && newData.child('reporterId').val() === auth.uid"
      }
    },
    "hashtags": {
      "$tag": {
        ".read": true,
        "$postId": {
          ".write": "auth != null && auth.token.email_verified === true && root.child('posts').child($postId).child('uid').val() === auth.uid"
        }
      }
    }
  }
}