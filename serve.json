{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin/index.html", "destination": "/admin.html" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/course", "destination": "/course.html" },
    { "source": "/course/", "destination": "/course.html" },
    { "source": "/course/index.html", "destination": "/course.html" },
    { "source": "/courses/:courseId", "destination": "/course.html" },
    { "source": "/courses/:courseId/lectures/:lessonId", "destination": "/course.html" },
    { "source": "/community.html", "destination": "/community/index.html" },
    { "source": "/community", "destination": "/community/index.html" },
    { "source": "/community/*", "destination": "/community/index.html" },
    { "source": "/community-app", "destination": "/community/index.html" },
    { "source": "/community-app/*", "destination": "/community/index.html" }
  ]
}
