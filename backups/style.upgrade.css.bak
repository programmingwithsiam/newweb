/* Backup of style.upgrade.css created before deletion */

/* Upgrade overrides copied from the React app styles to give the premium look.
   This file should be loaded after `style.css` to override specific rules.
*/

/* Theme tweaks */
:root {
  --accent: #06b6d4;
  --panel-glass: rgba(255,255,255,0.04);
}

/* Glassmorphism containers */
.panel-glass {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border: 1px solid rgba(255,255,255,0.04);
  backdrop-filter: blur(8px) saturate(120%);
  border-radius: 14px;
}

/* Header modernization */
#header {
  background: rgba(5,7,8,0.36);
  border-bottom: 1px solid rgba(255,255,255,0.03);
}
#header .logo { font-family: var(--font-display); letter-spacing: 1px; }

/* Hero CTA styles */
.hero .btn-primary { background: linear-gradient(90deg,#ffd43b,#06b6d4); color:#04060b; font-weight:700; padding:10px 16px; border-radius:10px; }
.hero .btn-outline { border:1px solid rgba(255,255,255,0.06); background: transparent; color:var(--text); padding:10px 14px; border-radius:10px; }

/* Project card premium look */
.project-card { transition: transform .28s var(--ease), box-shadow .28s var(--ease); }
.project-card:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(2,6,23,0.6); }

/* Responsive tweaks to prevent horizontal scroll */
html, body { max-width: 100%; overflow-x: hidden; }

/* Small-screen fallbacks for 3D sections */
@media (max-width: 768px) {
  .hero-ide, .hero .canvas-wrap { display: none; }
  .hero { padding: 40px 18px; }
}

/* Minimal particle canvas overlay style */
#particles { position: fixed; inset: 0; z-index: -2; pointer-events: none; opacity:0.6 }
