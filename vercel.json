{
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/live.html",
      "destination": "/live",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/index.html?slug=:slug"
    },
    {
      "source": "/courses/:courseId/lectures/:lessonId",
      "destination": "/course.html?course=:courseId&lesson=:lessonId"
    },
    {
      "source": "/course",
      "destination": "/course.html"
    },
    {
      "source": "/course/",
      "destination": "/course.html"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/courses/:courseId",
      "destination": "/course.html?course=:courseId"
    },
    {
      "source": "/courses/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/community/(.*)",
      "destination": "/community/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
