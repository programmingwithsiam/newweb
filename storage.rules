rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'mdsiamahmmedloselovestroy@gmail.com';
    }

    function isGoogleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function canAccessCourse(courseId) {
      return isAdmin() || (isGoogleUser() &&
        firestore.exists(/databases/(default)/documents/authorized_users/$(request.auth.token.email)) &&
        firestore.get(/databases/(default)/documents/authorized_users/$(request.auth.token.email)).data.access == 'granted');
    }

    match /community_images/{uid}/{fileName} {
      allow read: if true;
      allow write: if isGoogleUser() && request.auth.uid == uid &&
        request.resource.contentType.matches('image/.*') && request.resource.size <= 5242880;
      allow delete: if isGoogleUser() && request.auth.uid == uid;
    }

    match /profile-pictures/{uid}/{fileName} {
      allow read: if true;
      allow write: if isGoogleUser() && request.auth.uid == uid &&
        request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 5242880;
      allow delete: if isGoogleUser() && request.auth.uid == uid;
    }
  }
}
