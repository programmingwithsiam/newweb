rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email == 'mdsiamahmmedloselovestroy@gmail.com';
    }

    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function canAccessCourse(courseId) {
      let accessPath = /databases/(default)/documents/courseAccess/$(request.auth.uid);
      let coursePath = /databases/(default)/documents/courseAccess/$(request.auth.uid)/courses/$(courseId);
      return isAdmin() || (isVerifiedUser() &&
        firestore.exists(accessPath) &&
        firestore.get(accessPath).data.get('blocked', false) == false &&
        ((firestore.get(accessPath).data.get('allCourses', false) == true &&
          (!firestore.exists(coursePath) ||
            firestore.get(coursePath).data.status != 'revoked')) ||
         (firestore.exists(coursePath) &&
          firestore.get(coursePath).data.status == 'approved')));
    }

    match /payment-proofs/{uid}/{paymentId} {
      allow read: if isAdmin() || (isVerifiedUser() && request.auth.uid == uid);
      allow write: if isVerifiedUser() && request.auth.uid == uid &&
        request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 1048576;
      allow delete: if isAdmin() || (isVerifiedUser() && request.auth.uid == uid);
    }

    match /lessons/{courseId}/{moduleId}/{fileName} {
      allow read: if canAccessCourse(courseId);
      allow write: if isAdmin();
    }
  }
}
